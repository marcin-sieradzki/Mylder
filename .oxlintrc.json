{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "jsx-a11y", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/react-in-jsx-scope": "off",
    "react/exhaustive-deps": "warn",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true,
        "allowExportNames": [
          "metadata",
          "generateMetadata",
          "viewport",
          "generateViewport",
          "generateStaticParams",
          "dynamicParams"
        ]
      }
    ],
    "vitest/no-standalone-expect": [
      "error",
      {
        "additionalTestBlockFunctions": ["it.effect", "it.live", "it.effect.each"]
      }
    ]
  },
  "ignorePatterns": [
    ".next",
    "next-env.d.ts",
    "coverage",
    "playwright-report",
    "test-results",
    "out",
    "prototypes"
  ],
  "overrides": [
    {
      "files": ["src/domain/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(\\.\\./)+(app|i18n|map|screens|timetable|tracker)(/|$)|^@/",
                "message": "The domain rules import nothing from Mylder's other folders."
              },
              {
                "group": [
                  "react",
                  "react/**",
                  "react-dom",
                  "react-dom/**",
                  "next",
                  "next/**",
                  "effect",
                  "effect/**",
                  "@effect/*",
                  "server-only",
                  "server-only/**",
                  "client-only",
                  "client-only/**",
                  "@mylder/perron",
                  "@mylder/perron/**",
                  "node:*"
                ],
                "message": "The domain rules run on both sides, with no I/O, Effect, React or Next.js."
              }
            ]
          }
        ]
      }
    }
  ]
}
